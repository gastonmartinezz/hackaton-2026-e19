{
  "title": "ApiError",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BAD_REQUEST",
            "UNAUTHORIZED",
            "NOT_FOUND",
            "SESSION_NOT_FOUND",
            "PAYLOAD_TOO_LARGE",
            "RATE_LIMITED",
            "AI_UNAVAILABLE",
            "AI_INVALID_RESPONSE",
            "AI_REFUSED",
            "TIMEOUT",
            "INTERNAL"
          ]
        },
        "message": {
          "type": "string"
        },
        "requestId": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "code",
        "message",
        "requestId",
        "retryable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "error"
  ],
  "additionalProperties": false
}
