{
  "title": "InterpretResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "redirect"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        }
      },
      "required": [
        "sessionId",
        "type",
        "message",
        "url"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "question"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "answers": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "sessionId",
        "type",
        "message"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "const": "options"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "options": {
          "minItems": 2,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https?://"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            },
            "required": [
              "title",
              "url",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sessionId",
        "type",
        "message",
        "options"
      ],
      "additionalProperties": false
    }
  ]
}
