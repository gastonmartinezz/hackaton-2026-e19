{
  "title": "OptionsResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "options": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "steps": {
            "minItems": 1,
            "maxItems": 15,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "element": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "instruction": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "presentation": {
                  "type": "string",
                  "enum": [
                    "highlight",
                    "scrollAndHighlight"
                  ]
                },
                "waitFor": {
                  "type": "string",
                  "enum": [
                    "userInteraction",
                    "navigation",
                    "userConfirmation"
                  ]
                },
                "field": {
                  "type": "object",
                  "properties": {
                    "question": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "sensitive": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "question",
                    "sensitive"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "element",
                "instruction",
                "presentation",
                "waitFor"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "steps"
        ],
        "additionalProperties": false
      }
    },
    "requestedOptionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    }
  },
  "required": [
    "sessionId",
    "options"
  ],
  "additionalProperties": false
}
