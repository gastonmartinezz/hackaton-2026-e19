{
  "title": "NextStepRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "optionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "expectedStep": {
      "type": "object",
      "properties": {
        "element": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "presentation": {
          "type": "string",
          "enum": [
            "highlight",
            "scrollAndHighlight"
          ]
        },
        "waitFor": {
          "type": "string",
          "enum": [
            "userInteraction",
            "navigation",
            "userConfirmation"
          ]
        },
        "field": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sensitive": {
              "type": "boolean"
            }
          },
          "required": [
            "question",
            "sensitive"
          ],
          "additionalProperties": false
        },
        "safeToClick": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "element",
        "instruction",
        "presentation",
        "waitFor"
      ],
      "additionalProperties": false
    },
    "completedSteps": {
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "presentation": {
            "type": "string",
            "enum": [
              "highlight",
              "scrollAndHighlight"
            ]
          },
          "waitFor": {
            "type": "string",
            "enum": [
              "userInteraction",
              "navigation",
              "userConfirmation"
            ]
          },
          "field": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sensitive": {
                "type": "boolean"
              }
            },
            "required": [
              "question",
              "sensitive"
            ],
            "additionalProperties": false
          },
          "safeToClick": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "element",
          "instruction",
          "presentation",
          "waitFor"
        ],
        "additionalProperties": false
      }
    },
    "html": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "metadata": {
      "type": "object",
      "properties": {
        "page": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "language": {
              "type": "string",
              "minLength": 2,
              "maxLength": 10
            },
            "origin": {
              "type": "string",
              "maxLength": 200,
              "pattern": "^https?:\\/\\/[^/?#]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "sessionId",
    "optionId",
    "expectedStep",
    "completedSteps",
    "html"
  ],
  "additionalProperties": false
}
