{
  "title": "InterpretRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "messages": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      }
    },
    "user": {
      "type": "object",
      "properties": {
        "location": {
          "type": "object",
          "properties": {
            "country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "region": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "city": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "additionalProperties": false
        },
        "ageRange": {
          "type": "string",
          "enum": [
            "under-50",
            "50-64",
            "65-74",
            "75-plus"
          ]
        },
        "language": {
          "type": "string",
          "maxLength": 35,
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "timeZone": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_+-]+(?:\\/[A-Za-z0-9_+-]+)*$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "messages"
  ],
  "additionalProperties": false
}
