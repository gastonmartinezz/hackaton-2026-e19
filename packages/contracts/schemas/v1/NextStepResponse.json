{
  "title": "NextStepResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "steps": {
      "maxItems": 15,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "element": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "presentation": {
            "type": "string",
            "enum": [
              "highlight",
              "scrollAndHighlight"
            ]
          },
          "waitFor": {
            "type": "string",
            "enum": [
              "userInteraction",
              "navigation",
              "userConfirmation"
            ]
          },
          "field": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sensitive": {
                "type": "boolean"
              }
            },
            "required": [
              "question",
              "sensitive"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "element",
          "instruction",
          "presentation",
          "waitFor"
        ],
        "additionalProperties": false
      }
    },
    "done": {
      "type": "boolean"
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  },
  "required": [
    "sessionId",
    "steps",
    "done"
  ],
  "additionalProperties": false
}
