# Configuración del backend en el sandbox de Tenki.
# Copiar a deploy/tenki/.env.sandbox (no se versiona) y completar API_ACCESS_TOKENS.
# deploy.sh lo sube como apps/api/.env dentro del sandbox.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Tokens de acceso del piloto, separados por coma (mín. 24 caracteres c/u).
# Generar con: openssl rand -base64 32
API_ACCESS_TOKENS=

AI_PROVIDER=anthropic
# Marcador, no la clave: Tenki lo reemplaza por el secreto ANTHROPIC_API_KEY del workspace
# solo en las llamadas a api.anthropic.com permitidas por anthropic-policy.json.
# La clave real nunca entra al sandbox.
ANTHROPIC_API_KEY=secrets://ANTHROPIC_API_KEY
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_RETRIES=2

BODY_LIMIT_BYTES=524288
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
SESSION_TTL_MINUTES=30
