# Copiar a .env (no se versiona). Ningún secreto va en el cliente de escritorio.
NODE_ENV=development
HOST=::
PORT=3000
LOG_LEVEL=info

# Tokens de acceso del piloto por invitación, separados por coma (mín. 24 caracteres c/u).
# Generar con: openssl rand -base64 32
API_ACCESS_TOKENS=dev-token-solo-para-desarrollo-local

# mock: respuestas simuladas sin llamar a Claude. anthropic: API real.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_RETRIES=2
# Tope de tokens por respuesta; incluye el thinking adaptativo (con menos, las opciones largas se cortan).
CLAUDE_MAX_TOKENS=16000

# Límites
BODY_LIMIT_BYTES=524288
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
SESSION_TTL_MINUTES=30

# Protección de sitios (POST /v1/site-check). Ver docs/api.md y docs/mcp.md.
SITE_CHECK_RATE_LIMIT_MAX=120
# none | mock (solo desarrollo) | safe_browsing (Lookup API v4, uso no comercial) | web_risk (Google Cloud, comercial).
# Sin proveedor la reputación queda "unavailable" y el indicador nunca muestra un estado favorable.
REPUTATION_PROVIDER=mock
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_WEB_RISK_API_KEY=
# RDAP (registro de dominios vía bootstrap de IANA) e inspección de conexión/TLS/redirecciones.
SITE_CHECK_RDAP=true
# Registro de instituciones del BCU (bancos, financieras, cambios, AFAP, seguros y medios de pago): sitios web
# oficiales descargados del regulador al arrancar y cada 24 h. El tiempo máximo es por petición al BCU.
# Con false, lo que no está en las zonas del Estado ni en el catálogo queda «No pudimos verificarlo».
SITE_CHECK_BCU_REGISTRY=true
SITE_CHECK_BCU_TIMEOUT_MS=15000
# Opcional: dominios populares (por ejemplo, CrUX por país, licencia CC BY-SA 4.0) para detectar dominios parecidos.
SITE_CHECK_POPULAR_DOMAINS_FILE=
SITE_CHECK_POPULAR_DOMAINS_LIMIT=10000
SITE_CHECK_CONNECTION=true
# Explicación complementaria con el proveedor de IA configurado.
SITE_CHECK_AI=true
SITE_CHECK_PROVIDER_TIMEOUT_MS=4000
SITE_CHECK_CONNECTION_TIMEOUT_MS=5000
SITE_CHECK_AI_TIMEOUT_MS=8000
SITE_CHECK_PROVIDER_MAX_PER_MINUTE=120

# Servidor MCP privado (herramientas para la IA). Vacío = deshabilitado. Tokens distintos a API_ACCESS_TOKENS.
MCP_ACCESS_TOKENS=
MCP_HOST=127.0.0.1
MCP_PORT=3100

# Voz a texto (POST /v1/transcribe) con Whisper en este servidor, sin proveedores pagos.
# off: endpoint apagado (503 no reintentable). mock: texto fijo, sin modelo. local: Whisper en CPU.
STT_PROVIDER=mock
STT_MODEL=onnx-community/whisper-small
# q8 = pesos int8 (~250 MB). fp32 es más preciso pero ~4 veces más pesado y lento en CPU.
STT_DTYPE=q8
# Caché del modelo descargado (por defecto apps/api/.models).
# STT_MODEL_DIR=
STT_TIMEOUT_MS=30000
# Inferencias en paralelo (cada una carga su copia del modelo: ~0,6 GB de RAM por worker con q8).
STT_CONCURRENCY=1
# Solicitudes en espera además de las que corren.
STT_QUEUE_MAX=4
# Hilos de ONNX Runtime por worker; 0 = núcleos / STT_CONCURRENCY.
STT_THREADS=0
# Solicitudes por token y por RATE_LIMIT_WINDOW_MS.
STT_RATE_LIMIT_MAX=20
