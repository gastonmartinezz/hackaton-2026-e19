# Copiar a .env (no se versiona). Ningún secreto va en el cliente de escritorio.
NODE_ENV=development
HOST=::
PORT=3000
LOG_LEVEL=info

# Tokens de acceso del piloto por invitación, separados por coma (mín. 24 caracteres c/u).
# Generar con: openssl rand -base64 32
API_ACCESS_TOKENS=dev-token-solo-para-desarrollo-local

# mock: respuestas simuladas sin llamar a Claude. anthropic: API real.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Por tarea (opcionales): si no se definen, se usan CLAUDE_MODEL y CLAUDE_EFFORT.
# interpret, options y nextStep van con Claude Opus 5.5: Sonnet 5.5 low inventó URLs (ver docs/railway.md).
# CLAUDE_MODEL_INTERPRET=
# CLAUDE_EFFORT_INTERPRET=
# CLAUDE_MODEL_OPTIONS=
# CLAUDE_EFFORT_OPTIONS=
# CLAUDE_MODEL_NEXT_STEP=
# CLAUDE_EFFORT_NEXT_STEP=
# default: si el clasificador de seguridad rechaza, la API reintenta en el modelo recomendado
# (solo en modelos que lo admiten; Haiku 5.5 no). off: sin reintento.
CLAUDE_FALLBACKS=default
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_RETRIES=2
# Tope de tokens por respuesta; incluye el thinking adaptativo (con menos, las opciones largas se cortan).
CLAUDE_MAX_TOKENS=16000

# Verificación de las URLs que devuelve /v1/interpret (siempre activa: ninguna URL llega sin comprobar).
URL_CHECK_TIMEOUT_MS=5000
URL_CHECK_MAX_REDIRECTS=3
URL_CHECK_CACHE_TTL_MS=600000
# on: Claude elige entre resultados reales de la búsqueda web de Anthropic (más lento y caro; ver docs/railway.md).
INTERPRET_WEB_SEARCH=off
INTERPRET_WEB_SEARCH_MAX_USES=3

# Límites
BODY_LIMIT_BYTES=524288
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
SESSION_TTL_MINUTES=30

# Protección de sitios (POST /v1/site-check). Ver docs/api.md y docs/proteccion-sitios.md.
SITE_CHECK_RATE_LIMIT_MAX=120
# RDAP (registro de dominios vía bootstrap de IANA) e inspección de conexión/TLS/redirecciones.
SITE_CHECK_RDAP=true
# Registro de instituciones del BCU (bancos, financieras, cambios, AFAP, seguros y medios de pago): sitios web
# oficiales descargados del regulador al arrancar y cada 24 h. El tiempo máximo es por petición al BCU.
# Con false, lo que no está en las zonas del Estado ni en el catálogo queda «No pudimos verificarlo».
SITE_CHECK_BCU_REGISTRY=true
SITE_CHECK_BCU_TIMEOUT_MS=15000
# Opcional: dominios populares (por ejemplo, CrUX por país, licencia CC BY-SA 4.0) para detectar dominios parecidos.
SITE_CHECK_POPULAR_DOMAINS_FILE=
SITE_CHECK_POPULAR_DOMAINS_LIMIT=10000
SITE_CHECK_CONNECTION=true
# Explicación complementaria con el proveedor de IA configurado.
SITE_CHECK_AI=true
SITE_CHECK_PROVIDER_TIMEOUT_MS=4000
SITE_CHECK_CONNECTION_TIMEOUT_MS=5000
SITE_CHECK_AI_TIMEOUT_MS=8000
SITE_CHECK_PROVIDER_MAX_PER_MINUTE=120

# Voz a texto (POST /v1/transcribe).
# off: endpoint apagado (503 no reintentable). mock: texto fijo, sin modelo.
# openai: API de OpenAI (recomendado en Railway). local: Whisper en CPU en este servidor.
STT_PROVIDER=mock
STT_MODEL=onnx-community/whisper-small
# q8 = pesos int8 (~250 MB). fp32 es más preciso pero ~4 veces más pesado y lento en CPU.
STT_DTYPE=q8
# Caché del modelo descargado (por defecto apps/api/.models).
# STT_MODEL_DIR=
STT_TIMEOUT_MS=30000
# Transcripciones en paralelo. Por defecto 1 con local (cada worker carga su copia del modelo:
# ~0,6 GB de RAM con q8) y 8 con openai.
# STT_CONCURRENCY=
# Solicitudes en espera además de las que corren.
STT_QUEUE_MAX=4
# Hilos de ONNX Runtime por worker; 0 = núcleos / STT_CONCURRENCY.
STT_THREADS=0
# Solicitudes por token y por RATE_LIMIT_WINDOW_MS.
STT_RATE_LIMIT_MAX=20

# OpenAI: voz a texto (STT_PROVIDER=openai) y texto a voz (TTS_PROVIDER=openai).
# Claude sigue interpretando y guiando. Obligatoria si STT o TTS usan openai.
OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1
OPENAI_STT_MODEL=gpt-transcribe
# Contexto y palabras clave para la transcripción (vacíos por defecto). Valor propuesto y fuentes en docs/api.md.
OPENAI_STT_PROMPT=
OPENAI_STT_KEYWORDS=

# Texto a voz (POST /v1/speak). off: apagado (503 no reintentable). mock: MP3 corto de silencio. openai: OpenAI.
TTS_PROVIDER=mock
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
# Solicitudes por token y por RATE_LIMIT_WINDOW_MS.
TTS_RATE_LIMIT_MAX=30
TTS_TIMEOUT_MS=30000
