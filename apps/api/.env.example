# Copiar a .env (no se versiona). Ningún secreto va en el cliente de escritorio.
NODE_ENV=development
HOST=::
PORT=3000
LOG_LEVEL=info

# Tokens de acceso del piloto por invitación, separados por coma (mín. 24 caracteres c/u).
# Generar con: openssl rand -base64 32
API_ACCESS_TOKENS=dev-token-solo-para-desarrollo-local

# mock: respuestas simuladas sin llamar a Claude. anthropic: API real.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_RETRIES=2
# Tope de tokens por respuesta; incluye el thinking adaptativo (con menos, las opciones largas se cortan).
CLAUDE_MAX_TOKENS=16000

# Límites
BODY_LIMIT_BYTES=524288
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
SESSION_TTL_MINUTES=30

# Voz a texto (POST /v1/transcribe) con Whisper en este servidor, sin proveedores pagos.
# off: endpoint apagado (503 no reintentable). mock: texto fijo, sin modelo. local: Whisper en CPU.
STT_PROVIDER=mock
STT_MODEL=onnx-community/whisper-small
# q8 = pesos int8 (~250 MB). fp32 es más preciso pero ~4 veces más pesado y lento en CPU.
STT_DTYPE=q8
# Caché del modelo descargado (por defecto apps/api/.models).
# STT_MODEL_DIR=
STT_TIMEOUT_MS=30000
# Inferencias en paralelo (cada una carga su copia del modelo: ~0,6 GB de RAM por worker con q8).
STT_CONCURRENCY=1
# Solicitudes en espera además de las que corren.
STT_QUEUE_MAX=4
# Hilos de ONNX Runtime por worker; 0 = núcleos / STT_CONCURRENCY.
STT_THREADS=0
# Solicitudes por token y por RATE_LIMIT_WINDOW_MS.
STT_RATE_LIMIT_MAX=20
