# Copiar a .env (no se versiona). Ningún secreto va en el cliente de escritorio.
NODE_ENV=development
HOST=::
PORT=3000
LOG_LEVEL=info

# Tokens de acceso del piloto por invitación, separados por coma (mín. 24 caracteres c/u).
# Generar con: openssl rand -base64 32
API_ACCESS_TOKENS=dev-token-solo-para-desarrollo-local

# mock: respuestas simuladas sin llamar a Claude. anthropic: API real.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
CLAUDE_TIMEOUT_MS=30000
CLAUDE_MAX_RETRIES=2
# Tope de tokens por respuesta; incluye el thinking adaptativo (con menos, las opciones largas se cortan).
CLAUDE_MAX_TOKENS=16000

# Límites
BODY_LIMIT_BYTES=524288
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
SESSION_TTL_MINUTES=30
