{
  "$schema": "guiame-tokens/v2",
  "version": "2.2.0",
  "name": "Guíame",
  "color": {
    "ink": {
      "value": "#0B1B3F",
      "use": "Texto principal (navy)"
    },
    "ink-secondary": {
      "value": "#47557A",
      "use": "Texto de apoyo"
    },
    "border-control": {
      "value": "#7A8CC9",
      "use": "Borde 2px de botones secundarios, respuestas y campos"
    },
    "line": {
      "value": "#DCE4FA",
      "use": "Separadores, marcos de cita, borde de tarjetas de pregunta"
    },
    "surface": {
      "value": "#FFFFFF"
    },
    "surface-soft": {
      "value": "#F2F5FF",
      "use": "Pie de tarjeta, cajas de privacidad, superficies suaves"
    },
    "action-soft": {
      "value": "#E6EDFF",
      "use": "Chip con el nombre del control en la instrucción, píldoras"
    },
    "brand": {
      "value": "#1D4ED8",
      "use": "Azul de marca: enlaces, íconos, texto de acento"
    },
    "brand-dark": {
      "value": "#1638B8"
    },
    "brand-light": {
      "value": "#3B74FF"
    },
    "brand-azure": {
      "value": "#1F8BFF",
      "use": "Azul celeste del logo: anillo del resaltado"
    },
    "brand-sky": {
      "value": "#8FD0FF",
      "use": "Acento claro sobre fondos azules (presentaciones)"
    },
    "gradient-action": {
      "value": "linear-gradient(135deg, #3B74FF 0%, #1D4ED8 55%, #1638B8 100%)",
      "use": "UNA acción principal por vista; texto blanco"
    },
    "gradient-bar": {
      "value": "linear-gradient(90deg, #3A9BFF 0%, #2B86FF 50%, #1F74F0 100%)",
      "use": "Barra del navegador"
    },
    "gradient-card-head": {
      "value": "linear-gradient(180deg, #EAF3FF 0%, #FFFFFF 100%)",
      "use": "Encabezado claro de la tarjeta flotante"
    },
    "gradient-ground": {
      "value": "linear-gradient(180deg, #FFFFFF 0%, #F1F5FF 38%, #C9D8FF 72%, #5B8BFF 92%, #2F6BFF 100%)",
      "use": "Fondo de pantallas propias (inicio, preguntas, recomendación), con puntos"
    },
    "success": {
      "value": "#13693D",
      "on": "#E0F2E7",
      "use": "Sello «Sitio oficial», bloque «Listo»"
    },
    "warning": {
      "value": "#7A4D00",
      "on": "#FFF0CC",
      "use": "Sello «No verificado», bloque de aviso"
    },
    "error": {
      "value": "#B42318",
      "use": "Error de Guíame: borde e ícono; título en ink"
    }
  },
  "font": {
    "family": {
      "value": "'Poppins', 'Segoe UI', system-ui, sans-serif",
      "files": "assets/fonts/Poppins-{Light,Regular,Medium,SemiBold,Bold}.ttf"
    },
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "literal": {
      "value": "font-variant-numeric: tabular-nums",
      "use": "Códigos, N.º de pedido, fechas y citas literales"
    }
  },
  "size": {
    "instruction": {
      "value": "32px",
      "lineHeight": 1.3,
      "weight": 600
    },
    "heading-card": {
      "value": "31px",
      "lineHeight": 1.15,
      "weight": 600,
      "letterSpacing": "-0.025em"
    },
    "heading-question": {
      "value": "34px",
      "lineHeight": 1.2,
      "weight": 600,
      "letterSpacing": "-0.025em"
    },
    "heading-home": {
      "value": "48px",
      "lineHeight": 1.15,
      "weight": 600
    },
    "card-goal": {
      "value": "22px",
      "weight": 600
    },
    "support": {
      "value": "22px",
      "lineHeight": 1.45
    },
    "button-primary": {
      "value": "22px",
      "weight": 600
    },
    "button-secondary": {
      "value": "21px",
      "weight": 600
    },
    "answer": {
      "value": "24px",
      "weight": 600
    },
    "progress": {
      "value": "20px"
    },
    "highlight-label": {
      "value": "20px",
      "weight": 600
    },
    "minimum": {
      "value": "20px",
      "use": "Mínimo en la capa Guíame (19px solo sellos y rótulos)"
    }
  },
  "control-height": {
    "bar": "76px",
    "bar-control": "54px",
    "primary": "64px",
    "secondary": "58px",
    "answer": "72px",
    "minimum-touch-target": "48px"
  },
  "radius": {
    "control": "18px",
    "highlight": "12px",
    "card": "28px",
    "pill": "999px"
  },
  "shadow": {
    "card": "0 0 0 1px rgba(29,78,216,0.16), 0 0 0 10px rgba(59,116,255,0.16), 0 48px 90px -24px rgba(22,56,184,0.60)",
    "question-card": "0 0 0 8px rgba(59,116,255,0.10), 0 40px 80px -28px rgba(22,56,184,0.45)",
    "primary": "0 14px 28px -12px rgba(22,56,184,0.75)",
    "bar": "0 10px 30px -12px rgba(22,56,184,0.55)",
    "scrim": "rgba(11,27,63,0.45)"
  },
  "highlight": {
    "ring": "position: relative; z-index: 2; padding: 4px; border: 3px solid #FFFFFF; border-radius: 12px; box-shadow: 0 0 0 4px #1F8BFF, 0 0 0 12px rgba(31,139,255,0.25)",
    "label": "«Acá» 20px/600; color #FFFFFF; background linear-gradient(135deg, #3BA3FF 0%, #1D4ED8 100%); padding 6px 14px; border-radius 8px; box-shadow 0 0 0 3px #FFFFFF, 0 12px 26px -8px rgba(22,56,184,0.75)"
  },
  "spotlight": {
    "site-veil": "position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(90deg, rgba(11,27,63,0.08) 0%, rgba(11,27,63,0.16) 55%, rgba(22,56,184,0.30) 100%)",
    "z-order": "velo del sitio 1 < control resaltado 2 < barra 3 < tarjeta 5 < scrim de diálogo 6 < diálogo 7",
    "use": "Solo cuando la tarjeta está abierta o achicada. Sin tarjeta (21) no hay velo."
  },
  "pattern": {
    "ground-dots": "radial-gradient(circle, rgba(29,78,216,0.10) 1.3px, transparent 1.6px) 32px 32px, encima de gradient-ground"
  },
  "logo": {
    "bar": {
      "file": "assets/logo/guiame-blanco.png",
      "height": "38px",
      "on": "gradient-bar",
      "note": "«Guíame» blanco con avioncito, sin ojos (v2.2)"
    },
    "icon": {
      "file": "assets/logo/guiame-icono.png",
      "on": "fondos claros: encabezado de tarjeta (38px), inicio (78px), tarjeta achicada (40px)"
    },
    "pill-with-eyes": {
      "file": "assets/logo/guiame-pill-ojos.png",
      "on": "fondos blancos o claros (portadas, materiales)"
    },
    "wordmark-blue": {
      "file": "assets/logo/guiame-wordmark-azul.png",
      "on": "fondos blancos"
    },
    "wordmark-white": {
      "file": "assets/logo/guiame-wordmark-blanco.png",
      "on": "fondos azules u oscuros"
    },
    "white-with-eyes": {
      "file": "assets/logo/guiame-blanco-ojos.png",
      "on": "recurso; ya no se usa en la barra"
    }
  },
  "layout": {
    "artboard": "1440x900",
    "floating-card": {
      "width": "520px",
      "top": "100px",
      "right": "24px"
    },
    "minimized-card": {
      "width": "520px",
      "height": "80px"
    },
    "question-card-width": "880px",
    "site-usable-width": "≤ 880px: la tarjeta empieza en x=896 y nunca tapa el control resaltado"
  },
  "voice-button": {
    "height": {
      "home": "56px",
      "default": "52px"
    },
    "padding": "0 22px 0 18px",
    "radius": "999px",
    "background": "linear-gradient(135deg, #3B74FF 0%, #1D4ED8 55%, #1638B8 100%)",
    "color": "#FFFFFF",
    "shadow": "0 0 0 4px #DCE6FF, 0 10px 22px -10px rgba(22,56,184,0.75)",
    "font": {
      "home": "600 20px Poppins",
      "default": "600 19px Poppins"
    },
    "icon": {
      "name": "lucide mic",
      "stroke": "#FFFFFF",
      "stroke-width": 2.25
    },
    "label": "Hablar",
    "aria-label": "Hablar: decirlo en voz alta"
  }
}